# Copy this file to .env and fill in only the keys you have.
# The app runs in demo mode with no keys. Live YouTube search needs an API key.
# Live Reddit search uses the public JSON endpoint and does not need a key.
# PRAW credentials are optional. If both Reddit variables are set, PRAW is used
# instead of the public JSON endpoint.

YOUTUBE_API_KEY=

# Optional official Reddit app credentials (https://www.reddit.com/prefs/apps).
# Create a "script" app. Leave these blank to use public JSON search.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=socmint-prototype/0.1 (research assessment; public posts only)
