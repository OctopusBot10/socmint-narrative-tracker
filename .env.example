# Copy this file to .env. Live collection does not need an API key.

# Optional. Comma-separated public Nitter bases for the X search.
# The app tries these in order and stops at the first page that has posts.
# NITTER_INSTANCES=https://nitter.poast.org,https://nitter.privacydev.net,https://nitter.space,https://nitter.tiekoetter.com

# Optional ClaimBuster key. Scores how check-worthy a sentence is, not whether it is true.
# Leave blank to use the local wording heuristic.
# CLAIMBUSTER_API_KEY=

# Optional Google Sheet for new public Telegram rows.
# Share the sheet with the service account email as Editor.
# Leave both blank to append to results/telegram_public.csv instead.
# GOOGLE_SHEETS_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
# Or the raw JSON, used by the scheduled GitHub Action:
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Comma-separated public channel usernames for python collector_telegram.py.
# At most 20 channels per run.
# TELEGRAM_CHANNELS=channel_one,channel_two
